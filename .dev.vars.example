# Copy to .dev.vars for local development; NEVER commit the real file.
SUPABASE_URL=https://cxihsotcpdnalswfoysx.supabase.co
SUPABASE_ANON_KEY=replace_with_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret_key
COUPON_SIGNING_KEY=replace_with_long_random_secret_at_least_32_chars

# Optional invitation email; off by default until a verified sender domain and provider are configured.
INVITATION_EMAIL_ENABLED=false
INVITATION_FROM_EMAIL=invite@YOUR_VERIFIED_SENDER_DOMAIN
# RESEND_API_KEY must be configured as encrypted Worker secret. Never commit a real key.

# Explicit fail-closed release switch; omit/false means no business API or Cron.
OILSTATION_API_ENABLED=false
