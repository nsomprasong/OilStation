{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oilstation",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "env": {
    "uat": {
      "name": "oilstation-uat",
      "workers_dev": true,
      "triggers": {
        "crons": []
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*"
        ]
      },
      "vars": {
        "OILSTATION_DEPLOY_TARGET": "uat",
        "OILSTATION_API_ENABLED": "false",
        "INVITATION_EMAIL_ENABLED": "false",
        "INVITATION_FROM_EMAIL": "no-reply@oilstation.goldensoft.cloud"
      }
    }
  },
  "vars": {
    "OILSTATION_DEPLOY_TARGET": "production",
    "OILSTATION_PREVIEW_LOGIN_ENABLED": "true",
    "OILSTATION_API_ENABLED": "false",
    "INVITATION_EMAIL_ENABLED": "true",
    "INVITATION_FROM_EMAIL": "no-reply@oilstation.goldensoft.cloud",
    "OILSTATION_PREVIEW_OPERATIONS_ENABLED": "true",
    "OILSTATION_QA_ORGANIZATION_IDS": "d6f31134-2c74-41d8-8bc3-6d83bb41840b,948d946d-aa98-4718-b246-991313371ddb,db30c758-533c-463c-a226-d49f032e960a,e5cb8456-5611-421b-8265-229f6b1daa65",
    "OILSTATION_QA_STATION_IDS": "e22fb5ff-1878-446f-ab8d-585115e8a1a9,76388e2c-ef36-4656-808b-7d0fbd1d2c35,24dc4981-0e6f-4b86-bfd7-03717002d0be,02183a4e-47b0-4575-9f4f-74cec6553205",
    "OILSTATION_QA_COMPANY_IDS": ""
  }
}
