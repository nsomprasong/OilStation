{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oilstation",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "env": {
    "uat": {
      "name": "oilstation-uat",
      "workers_dev": true,
      "triggers": {
        "crons": []
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*"
        ]
      },
      "vars": {
        "OILSTATION_DEPLOY_TARGET": "uat",
        "OILSTATION_API_ENABLED": "false",
        "INVITATION_EMAIL_ENABLED": "false",
        "INVITATION_FROM_EMAIL": "no-reply@oilstation.goldensoft.cloud"
      }
    }
  },
  "vars": {
    "OILSTATION_DEPLOY_TARGET": "production",
    "OILSTATION_PREVIEW_LOGIN_ENABLED": "true",
    "OILSTATION_API_ENABLED": "false",
    "INVITATION_EMAIL_ENABLED": "true",
    "INVITATION_FROM_EMAIL": "no-reply@oilstation.goldensoft.cloud",
    "OILSTATION_PREVIEW_OPERATIONS_ENABLED": "true",
    "OILSTATION_QA_ORGANIZATION_IDS": "d6f31134-2c74-41d8-8bc3-6d83bb41840b,948d946d-aa98-4718-b246-991313371ddb,db30c758-533c-463c-a226-d49f032e960a,e5cb8456-5611-421b-8265-229f6b1daa65",
    "OILSTATION_QA_STATION_IDS": "e22fb5ff-1878-446f-ab8d-585115e8a1a9,76388e2c-ef36-4656-808b-7d0fbd1d2c35,24dc4981-0e6f-4b86-bfd7-03717002d0be,02183a4e-47b0-4575-9f4f-74cec6553205",
    "OILSTATION_QA_COMPANY_IDS": "4e6a3fc9-217d-4543-885b-113f1f3ba4c3,7f3dae09-5ff4-409c-bdf8-049086f99b7a,ff5796e7-e567-4790-aec6-0d5101fcd884,ab0a1f24-9a15-4a00-9da8-0a09397e4b24,4b19a8db-6b66-4707-8c5e-46648adbbe31,86bec094-71b8-4d9c-bea8-fdeed7c2ca66,9f202115-6bdd-47d9-a7a0-81ee9a7a1cc6,963161ff-078a-4176-8762-47daf1075d20,c55f48a5-76b2-478f-97ea-727f03ed2a9d,9da2618b-151c-45df-aad6-16519ec76535,9b6da1cc-946f-4756-8e0e-8ce020ca6209,88a9d686-e2c3-4cef-8a2a-1a888354a4c7"
  }
}
